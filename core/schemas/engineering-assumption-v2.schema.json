{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-mcu-agent.local/schemas/engineering-assumption-v2.schema.json",
  "title": "MCU Agent Engineering Assumption v2",
  "type": "object",
  "required": ["schema_version", "id", "mode", "state", "task_ids", "scope", "assumption", "risks", "validation_method", "owner", "expires_at", "rollback", "approved_by"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "audit": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "array", "items": {"type": "object", "additionalProperties": true}}]},
    "mode": {"enum": ["prototype", "exploration"]},
    "state": {"enum": ["PROPOSED", "APPROVED", "EXPIRED", "REVOKED", "VALIDATED"]},
    "task_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "scope": {"type": "string", "minLength": 1},
    "assumption": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "validation_method": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "approved_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
