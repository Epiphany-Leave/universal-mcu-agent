{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-mcu-agent.local/schemas/artifact-manifest-v2.schema.json",
  "title": "MCU Agent Canonical Artifact Manifest v2",
  "type": "object",
  "required": ["schema_version", "revision", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "revision": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "role", "logical_name", "path", "media_type", "identity", "revision", "sha256", "producer", "dependencies", "supersedes", "evidence_class", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "logical_name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
          "producer": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_class": {"type": "string", "minLength": 1},
          "status": {"enum": ["CURRENT", "STALE", "SUPERSEDED", "REJECTED"]},
          "accepted_by": {"type": ["string", "null"]},
          "accepted_at": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
