{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-mcu-agent.local/schemas/project-status.schema.json",
  "title": "Universal MCU Agent derived project status v1",
  "type": "object",
  "required": ["schema_version", "state", "contract_digest", "project_root", "missing_artifact_roles", "errors", "evaluated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["UNINITIALIZED", "PROJECT_INITIALIZED", "EVIDENCE_PENDING", "IMPLEMENTATION_ALLOWED", "INVALID"]},
    "contract_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "project_root": {"type": ["string", "null"]},
    "missing_artifact_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "string"}},
    "evaluated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
