{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-mcu-agent.local/schemas/engineering-assumption.schema.json",
  "title": "MCU Agent Engineering Assumption Record",
  "type": "object",
  "required": ["schema_version", "id", "mode", "scope", "assumption", "source", "rationale", "risks", "validation_plan", "owner", "expires_at", "rollback"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["prototype", "exploration"]},
    "scope": {"type": "string", "minLength": 1},
    "assumption": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "validation_plan": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "approved_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
